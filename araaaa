-- Cached coins (full GetDescendants every loop was causing 5-10s freezes)
local coinCache = {}
local lastCoinScan = 0

local function isCoinPart(v)
    if not v or not v.Parent or VS[v] then return false end
    if v.Name ~= "Coin_Server" or not v:IsA("BasePart") then return false end
    return v:FindFirstChild("TouchInterest") or v:FindFirstChildWhichIsA("TouchTransmitter")
end

local function rebuildCoinCache()
    coinCache = {}
    -- Prefer CoinContainer (fast + reliable)
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.Name == "CoinContainer" then
            for _, child in ipairs(obj:GetChildren()) do
                if isCoinPart(child) then
                    table.insert(coinCache, child)
                end
            end
        end
    end
    if #coinCache == 0 then
        for _, v in ipairs(workspace:GetDescendants()) do
            if isCoinPart(v) then
                table.insert(coinCache, v)
            end
        end
    end
    lastCoinScan = tick()
    return #coinCache
end

workspace.DescendantAdded:Connect(function(obj)
    task.defer(function()
        if isCoinPart(obj) then
            table.insert(coinCache, obj)
        elseif obj.Name == "TouchInterest" or obj.ClassName == "TouchTransmitter" then
            local p = obj.Parent
            if isCoinPart(p) then table.insert(coinCache, p) end
        end
    end)
end)

task.spawn(function()
    task.wait(0.5)
    rebuildCoinCache()
    while true do
        task.wait(2)
        rebuildCoinCache()
    end
end)

local function getCoins()
    local list = {}
    for i = #coinCache, 1, -1 do
        local v = coinCache[i]
        if isCoinPart(v) then
            table.insert(list, v)
        else
            table.remove(coinCache, i)
        end
    end
    if #list == 0 and tick() - lastCoinScan > 0.8 then
        rebuildCoinCache()
        for _, v in ipairs(coinCache) do
            if isCoinPart(v) then table.insert(list, v) end
        end
    end
    return list
end

