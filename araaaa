-- =========================================================
-- (FARM LOOP - 5 MODES)
-- FlatUnder: under map, flat, ~4 studs below coin, firetouchinterest
-- Surface: walk above coin
-- Tween: TweenService to coin
-- TPTouch: CFrame to coin + touch
-- Random: random target + surface
-- =========================================================
-- Flat on surface at coin height (not underground)
local FLAT = CFrame.Angles(math.rad(90), 0, 0)

local function moveFlat(root, coinPos, speed)
    setNoclip(true)
    local dest = Vector3.new(coinPos.X, coinPos.Y, coinPos.Z)
    local start = root.Position
    local dist = (dest - start).Magnitude
    speed = math.clamp(speed or SP or 20, 5, 100)
    if dist < 1.5 then
        root.CFrame = CFrame.new(dest) * FLAT
        root.AssemblyLinearVelocity = Vector3.zero
        return true
    end
    local duration = math.clamp(dist / speed, 0.05, 2.5)
    local t0 = tick()
    while root and root.Parent do
        local a = math.min((tick() - t0) / duration, 1)
        local p = start:Lerp(dest, a)
        root.CFrame = CFrame.new(p) * FLAT
        root.AssemblyLinearVelocity = Vector3.zero
        if a >= 1 then return true end
        task.wait()
    end
    return false
end

local function moveTween(root, dest, speed)
    local dist = (dest - root.Position).Magnitude
    local t = math.clamp(dist / math.max(speed, 12), 0.05, 3)
    local tw = TS:Create(root, TweenInfo.new(t, Enum.EasingStyle.Linear), {CFrame = CFrame.new(dest)})
    tw:Play()
    tw.Completed:Wait()
end

local function pickTarget(candidates, root)
    if #candidates == 0 then return nil, math.huge end
    table.sort(candidates, function(a, b) return a.dist < b.dist end)
    if FARM_MODE == "Random" then
        local n = #candidates
        local pick = candidates[math.random(1, n)]
        return pick.obj, pick.dist
    end
    if COIN_MODE == "Closest" or FARM_MODE == "TPTouch" then
        return candidates[1].obj, candidates[1].dist
    end
    -- Spread-style mid pick for Surface/Tween/FlatUnder when COIN_MODE Spread
    local n = #candidates
    if n <= 2 then
        local p = candidates[math.random(1, n)]
        return p.obj, p.dist
    end
    local a = math.max(1, math.floor(n * 0.25))
    local b = math.min(n, math.ceil(n * 0.75))
    local p = candidates[math.random(a, b)]
    return p.obj, p.dist
end

task.spawn(function()
    local lastClear = tick()
    while true do
        if AF then
            local ping = getPing()
            if ping > 280 then
                task.wait(0.4)
            else
                local ch = lp.Character
                local root = ch and ch:FindFirstChild("HumanoidRootPart")
                local hum = ch and ch:FindFirstChild("Humanoid")
                if root and hum and hum.Health > 0 then
                    if flinging then
                        task.wait(0.2)
                    else
                        if tick() - lastClear > 30 then
                            VS = {}
                            lastClear = tick()
                            rebuildCoinCache()
                        end

                        local allCoins = getCoins()
                        local candidates = {}
                        for _, obj in ipairs(allCoins) do
                            local d = (obj.Position - root.Position).Magnitude
                            if d < RG then
                                table.insert(candidates, {obj = obj, dist = d})
                            end
                        end
                        local target, dist = pickTarget(candidates, root)

                        if target and target.Parent then
                            local before = realCoins
                            local coinPos = target.Position

                            if FARM_MODE == "FlatUnder" then
                                -- Flat on surface at coin (not under map)
                                setNoclip(true)
                                hum.AutoRotate = false
                                hum.PlatformStand = false
                                root.Anchored = false
                                moveFlat(root, coinPos, SP)
                                local tWait = tick()
                                while tick() - tWait < 0.55 do
                                    if not (root and root.Parent and target and target.Parent) then break end
                                    root.CFrame = CFrame.new(coinPos) * FLAT
                                    root.AssemblyLinearVelocity = Vector3.zero
                                    touchCoin(target, root)
                                    if realCoins > before then break end
                                    if not target:FindFirstChild("TouchInterest") then break end
                                    task.wait(0.04)
                                end
                            elseif FARM_MODE == "Tween" then
                                if NOCLIP then setNoclip(true) end
                                hum.AutoRotate = true
                                root.Anchored = false
                                local dest = coinPos + Vector3.new(0, 2, 0)
                                moveTween(root, dest, SP)
                                touchCoin(target, root)
                                local tWait = tick()
                                while tick() - tWait < 0.4 do
                                    if root and target and target.Parent then
                                        root.CFrame = CFrame.new(coinPos + Vector3.new(0, 2, 0))
                                        touchCoin(target, root)
                                    end
                                    if realCoins > before or not target.Parent then break end
                                    if not target:FindFirstChild("TouchInterest") then break end
                                    task.wait(0.05)
                                end
                            elseif FARM_MODE == "TPTouch" then
                                setNoclip(true)
                                root.CFrame = CFrame.new(coinPos + Vector3.new(0, 2.5, 0))
                                touchCoin(target, root)
                                task.wait(0.08)
                                touchCoin(target, root)
                                task.wait(0.08)
                            else
                                -- Surface or Random
                                if NOCLIP then setNoclip(true) end
                                hum.PlatformStand = false
                                hum.AutoRotate = true
                                root.Anchored = false
                                local dest = coinPos + Vector3.new(0, 2, 0)
                                safeMoveTo(root, dest, SP)
                                touchCoin(target, root)
                                local tWait = tick()
                                while tick() - tWait < 0.45 do
                                    if root and target and target.Parent then
                                        root.CFrame = CFrame.new(coinPos + Vector3.new(0, 2, 0))
                                        touchCoin(target, root)
                                    end
                                    if realCoins > before or not target.Parent then break end
                                    if not target:FindFirstChild("TouchInterest") then break end
                                    task.wait(0.05)
                                end
                            end

                            VS[target] = true
                            CL = CL + 1
                            task.wait(COIN_DELAY)
                        else
                            task.wait(0.1)
                        end
                    end
                else
                    task.wait(0.25)
                end
            end
        else
            restoreMovement()
            task.wait(0.4)
        end
    end
end)


